!budget_forcing/weights/adapter_model.safetensors

# Python and notebook runtime artifacts
__pycache__/
**/__pycache__/
*.py[cod]
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Colab exports and transient partial evaluation files
*.zip
*.partial.json
